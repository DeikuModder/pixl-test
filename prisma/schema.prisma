generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         BigInt   @unique @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  username   String
  password   String
  email      String   @unique
  role       String?  @default("\"user\"")

  @@id([id, username, password, email])
}

model Event {
  id          BigInt  @unique @default(autoincrement())
  date        String
  user_id     String
  title       String
  description String
  price       Float
  image_url   String?

  @@id([id, date, user_id, title, description, price])
}

model Transaction {
  id         BigInt   @unique @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user_id    String
  event_id   String
  status     String
  price      Float
}
